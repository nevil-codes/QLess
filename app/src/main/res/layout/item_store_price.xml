<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_store_price_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_store"
        app:tint="@color/text_tertiary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Tesco Piccadilly" />

        <TextView
            android:id="@+id/txtStockStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/geist_regular"
            android:textSize="12sp"
            tools:text="In Stock" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono_medium"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="€9.99" />

        <TextView
            android:id="@+id/txtOriginalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono_regular"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            tools:text="€11.99" />
    </LinearLayout>

    <!-- Cheapest badge -->
    <TextView
        android:id="@+id/txtCheapest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_success_container"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp"
        android:text="@string/lowest_price"
        android:textColor="@color/success"
        android:textSize="11sp"
        android:fontFamily="@font/geist_medium"
        android:visibility="gone" />
</LinearLayout>

